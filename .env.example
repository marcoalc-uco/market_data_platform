# =============================================================================
# Root .env.example — Shared infrastructure variables
# Copy this file to .env and adjust values as needed.
# Scope: variables consumed by docker-compose.yml at the monorepo root.
# Service-specific vars live in each service's own .env.example
# =============================================================================
# NOTE: Do NOT wrap values in quotes — docker-compose reads them literally.

# ── Infrastructure (PostgreSQL) ───────────────────────────────────────────────
POSTGRES_USER=market_data
POSTGRES_PASSWORD=market_data_pass
POSTGRES_DB=market_data

# ── Infrastructure (Grafana) ──────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Backend ───────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
INGESTION_INTERVAL_MINUTES=60
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_EMAIL=admin@market.com

# ── Docker Secrets (NOT env vars — create these files before running make up) ─
# Both values are injected via Docker Secrets mounted at /run/secrets/<name>.
# pydantic-settings reads them automatically via secrets_dir="/run/secrets".
#
# secrets/secret_key.txt → generate with:
#   openssl rand -hex 32 > secrets/secret_key.txt
#
# secrets/admin_password_hash.txt → generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())" > secrets/admin_password_hash.txt
# Uses Docker Secret because bcrypt hashes contain '$' which docker-compose
# would interpolate incorrectly if passed as a regular env var.
