# =============================================================================
# Root .env.example — Shared infrastructure variables
# Copy this file to .env and adjust values as needed.
# Scope: variables consumed by docker-compose.yml at the monorepo root.
# Service-specific vars live in each service's own .env.example
# =============================================================================

# ── Infrastructure (PostgreSQL) ───────────────────────────────────────────────
POSTGRES_USER=market_data
POSTGRES_PASSWORD=market_data_pass
POSTGRES_DB=market_data

# ── Infrastructure (Grafana) ──────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Backend ───────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
INGESTION_INTERVAL_MINUTES=60
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_EMAIL=admin@market.com
# Generate SECRET_KEY with: openssl rand -hex 32
# NOTE: Do NOT wrap value in quotes — docker-compose reads it literally
# ADMIN_PASSWORD_HASH must be set via environment (not this file) to avoid
# '$' interpolation issues in docker-compose. See docker-compose.yml comments.

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
